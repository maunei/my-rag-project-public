# Copy to ".env" and fill every section below: GCP/GCS identifiers AND all local directory
# roots are required together (see README → "Configure .env").
# Application Default Credentials handle auth (gcloud auth application-default login);
# these IDs tell the SDK which project/bucket to use.
GCP_PROJECT=
GCS_BUCKET=

# Optional (defaults shown):
# GCP_LOCATION=us-central1
# GEMINI_MODEL=gemini-2.5-flash

# ── Required local directories (papers-rag v2.5+) ────────────────────────────
# PDF corpus root (must already exist).
PAPERS_DIR=

# Chroma persistence directory (created if missing).
CHROMA_DB_PATH=

# Mirrored sidescar JSON metadata per PDF (created if missing).
ABSTRACT_META_ROOT=

# Where "Export context for external LLM" writes prompt_context_*.txt (created).
EXPORTED_PROMPTS_DIR=

# Base folder for staged Deep Chat symlinks/copies; each staging run uses a timestamp subfolder.
SELECTED_PDFS_DIR=

# ── NCBI / Entrez credentials (optional — PubMed enrichment) ─────────────────
# Set NCBI credentials: NCBI_EMAIL is the CONTACT address for your NCBI account.
# NCBI_API_KEY is optional but improves Entrez throughput.
# See https://eutilities.github.io/site/API_Key/usageandkey/
# NCBI_EMAIL=your.address@gmail.com
# NCBI_API_KEY=
#
# Alias names also accepted by the CLI: ENTREZ_EMAIL / ENTREZ_API_KEY
