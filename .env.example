# Copy to ".env" and fill every section below: GCP/GCS identifiers AND all local directory
# roots are required together (see README → "Configure .env").
# Application Default Credentials handle auth (gcloud auth application-default login);
# these IDs tell the SDK which project/bucket to use.
GCP_PROJECT=
GCS_BUCKET=

NCBI_EMAIL=
NCBI_API_KEY=
# Alias names also accepted by the CLI: ENTREZ_EMAIL / ENTREZ_API_KEY

PAPERS_DIR=

# Default values
PAPER_DISCOVERY_BATCH_CHUNKS=5000
PAPER_DISCOVERY_MAX_CHUNKS=20000
EVIDENCE_CHUNKS_PER_PAPER=3
KEYWORD_SEARCH_BACKEND=fts
KEYWORD_MAX_PAPERS=0
PDF_SERVER_PORT=8502




# Optional (defaults shown):
# GCP_LOCATION=us-central1
# GEMINI_MODEL=gemini-2.5-flash





