# Copy to ".env" and fill in. Application Default Credentials handle auth
# (gcloud auth application-default login); these IDs tell the SDK which project/bucket to use.

GCP_PROJECT=
GCS_BUCKET=

# Optional (defaults shown):
# GCP_LOCATION=us-central1
# GEMINI_MODEL=gemini-2.5-flash

# ── NCBI / Entrez credentials (optional — used by extract_abstracts.py --pubmed-meta) ──
# Set NCBI credentials, not literally an "ncbi mailbox": NCBI_EMAIL is the CONTACT
# address you associate with your NCBI account — often your regular email (Gmail ok).
# NCBI_API_KEY is optional but recommended for higher API throughput; request via NCBI.
# See https://eutilities.github.io/site/API_Key/usageandkey/
# NCBI_EMAIL=your.address@gmail.com
# NCBI_API_KEY=
#
# Alias names also accepted by the CLI: ENTREZ_EMAIL / ENTREZ_API_KEY
